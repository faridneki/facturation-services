// Prisma Schema pour Factura - Application de Facturation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  uid       String    @unique
  email     String
  createdAt DateTime? @default(now()) @map("created_at")

  @@map("users")
}

model CompanyInfo {
  id          String    @id
  userId      String?   @map("user_id")
  name        String
  legalName   String?   @map("legal_name")
  taxId       String?   @map("tax_id")
  rc          String?
  ai          String?
  nis         String?
  art         String?
  address     String?
  city        String?
  postalCode  String?   @map("postal_code")
  country     String?   @default("Algérie")
  phone       String?
  email       String?
  website     String?
  logoUrl     String?   @map("logo_url")
  logoBase64  String?   @map("logo_base64")
  footerText  String?   @map("footer_text")
  legalTerms  String?   @map("legal_terms")
  bankName    String?   @map("bank_name")
  bankAccount String?   @map("bank_account")
  bankRib     String?   @map("bank_rib")
  updatedAt   DateTime? @default(now()) @map("updated_at")

  @@map("company_info")
}

model Client {
  id           String    @id
  userId       String?   @map("user_id")
  nom          String
  email        String?
  telephone    String
  adresse      String?
  ncBancaire   String?   @map("nc_bancaire")
  nif          String?
  rc           String?
  ai           String?
  nis          String?
  creditMax    Float?    @default(0) @map("credit_max")
  creditActuel Float?    @default(0) @map("credit_actuel")
  createdAt    DateTime? @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @map("updated_at")

  @@map("clients")
}

model Invoice {
  id              String    @id
  userId          String?   @map("user_id")
  number          String
  type            String
  status          String
  clientId        String    @map("client_id")
  issueDate       String    @map("issue_date")
  dueDate         String    @map("due_date")
  paymentDate     String?   @map("payment_date")
  paymentMethod   String?   @map("payment_method")
  itemsJson       String    @map("items_json")
  subtotalHT      Float     @map("subtotal_ht")
  discountAmount  Float     @map("discount_amount")
  taxAmount       Float     @map("tax_amount")
  totalTTC        Float     @map("total_ttc")
  depositAmount   Float?    @default(0) @map("deposit_amount")
  notes           String?
  paymentTerms    String?   @map("payment_terms")
  convertedFromId String?   @map("converted_from_id")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @default(now()) @map("updated_at")

  @@map("invoices")
}

